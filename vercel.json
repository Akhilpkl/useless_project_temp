{
  "version": 2,
  "builds": [
    {
      "src": "whyculator/app.py",
      "use": "@vercel/python"
    },
    {
      "src": "whyculator/static/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "whyculator/static/$1" },
    { "src": "/(.*)", "dest": "whyculator/app.py" }
  ]
}
